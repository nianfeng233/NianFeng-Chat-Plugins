{
  "id": "github-hub",
  "name": "github-hub",
  "displayName": "GitHub 助手",
  "version": "2.0.1",
  "author": "念风扩展",
  "description": "GitHub 仓库订阅推送、聊天内项目卡片预览、LLM 只读分析并回复 Issue、自主动态屏蔽刷屏用户。独立扩展，不修改本体。",
  "entry": "./index.mjs",
  "backend": "./bridge.mjs",
  "icon": "🐙",
  "color": "#24292f",
  "type": "extension",
  "core": false,
  "permissions": [
    "network",
    "storage"
  ],
  "depends": {
    "event-bus": "*",
    "tool-registry": "^1.0.0",
    "channel-registry": "^1.0.0",
    "session-service": "^2.0.0",
    "message-service": "^1.0.0"
  },
  "optionalDepends": {
    "backend-client": ">=1.0.0",
    "plugin-manager": ">=1.0.0",
    "settings-container": "^1.0.0",
    "image-service": "^1.0.0",
    "notification": "^2.0.0",
    "modal-host": ">=1.0.0",
    "toast-host": ">=1.0.0",
    "channel-base": "^1.0.0"
  },
  "provides": [],
  "distribution": {
    "directory": "extensions/github-hub",
    "zip": "github-hub-v2.0.1.zip",
    "placement": "外部插件：<数据目录>/plugins/github-hub/（也可在「设置 → 插件 → 添加插件」里直接上传 zip）。安装后到「设置 → 插件」点一次「重新扫描」，新版内核会同时热加载后端桥。"
  },
  "scope": "both"
}

